# Токен от @BotFather
BOT_TOKEN=

# Цифровые Telegram ID администраторов через запятую
ADMIN_IDS=

# Ссылка на канал бренда (можно приватную invite-ссылку)
CHANNEL_URL=https://t.me/+XufFz8GGR0o3Njky

# HTTPS-адрес Mini App. После публикации домена вставь его сюда.
# Кнопка появится в меню бота автоматически.
WEBAPP_URL=

# Куда падают уведомления о новых заявках
MANAGER_CHAT_ID=

# Временное рабочее имя. Если Никита даст отдельное название бренда одежды — меняется одной строкой.
BRAND_NAME=ВОРОЖБИТОВ
SUPPORT_USERNAME=

# Ссылка на политику обработки персональных данных (показываем перед сбором номера)
PRIVACY_URL=

# Сколько приглашённых нужно, чтобы попасть в пул розыгрыша
GIVEAWAY_MIN_INVITES=3

DATABASE_PATH=data/bot.sqlite3
# В Docker каталог хранится рядом с базой в writable volume. При первом старте
# он автоматически копируется из встроенного catalog.json.
CATALOG_PATH=data/catalog.json
PORT=8080
LOG_LEVEL=INFO
