# Токен от @BotFather
BOT_TOKEN=

# Цифровые Telegram ID администраторов через запятую
ADMIN_IDS=

# Ссылка на канал бренда (можно приватную invite-ссылку)
CHANNEL_URL=https://t.me/+XufFz8GGR0o3Njky

# HTTPS-адрес Mini App. После публикации домена вставь его сюда.
# Кнопка появится в меню бота автоматически.
WEBAPP_URL=

# Куда падают уведомления о новых заявках
MANAGER_CHAT_ID=

# Временное рабочее имя. Если Никита даст отдельное название бренда одежды — меняется одной строкой.
BRAND_NAME=ВОРОЖБИТОВ
SUPPORT_USERNAME=

# Ссылка на политику обработки персональных данных (показываем перед сбором номера)
PRIVACY_URL=

# Сколько приглашённых нужно, чтобы попасть в пул розыгрыша
GIVEAWAY_MIN_INVITES=3

# --- Оплата ---
# Пустой ключ = способ не показывается. Звёзды работают без ключей Лавы/крипты.
# Лава (карты, СБП). LAVA_HOOK_KEY — обязательный отдельный «дополнительный ключ» вебхука.
# Без него Lava отключена; исходящий LAVA_SECRET_KEY не используется как fallback.
LAVA_SHOP_ID=
LAVA_SECRET_KEY=
LAVA_HOOK_KEY=

# Crypto Pay (@CryptoBot). Вебхук: https://твой-домен/api/payments/crypto
CRYPTO_PAY_TOKEN=

# Telegram Stars. Курс — сколько рублей в одной звезде.
STARS_ENABLED=1
STARS_RUB_PER_STAR=2

DATABASE_PATH=data/bot.sqlite3
# В Docker каталог хранится рядом с базой в writable volume. При первом старте
# он автоматически копируется из встроенного catalog.json.
CATALOG_PATH=data/catalog.json
PORT=8080
LOG_LEVEL=INFO

# Только точные IP доверенных reverse proxy (адрес peer, который видит бот).
# Пусто = X-Real-IP и X-Forwarded-For не считаются доверенными.
# Proxy должен ПЕРЕЗАПИСЫВАТЬ X-Real-IP адресом клиента, а не передавать входной заголовок.
TRUSTED_PROXY_IPS=

# --- Однократные пользовательские сигналы (отдельное согласие) ---
# По умолчанию выключены. Включать после проверки на отдельном боте и согласования условий.
PRODUCT_ALERTS_ENABLED=0
# Публичная HTTPS-политика для уведомлений. Пусто = использовать PRIVACY_URL.
PRODUCT_ALERTS_POLICY_URL=
